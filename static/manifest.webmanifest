{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Ad Vandi - Truck Run Tracker",
  "short_name": "Ad Vandi",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#080c16",
  "theme_color": "#080c16",
  "description": "Daily truck run tracker: odometer reading, location check-ins, business visits, and fuel records.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Today's Run",
      "short_name": "Start Run",
      "description": "Photograph odometer and start daily run",
      "url": "/?action=start",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Location Check-in",
      "short_name": "Location",
      "description": "Upload current geo-tagged location photo",
      "url": "/?action=location",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Business Visit",
      "short_name": "Visit",
      "description": "Log business visit and collection",
      "url": "/?action=visit",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Upload Fuel Bill",
      "short_name": "Fuel Bill",
      "description": "Photograph diesel or petrol receipt",
      "url": "/?action=fuel",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
